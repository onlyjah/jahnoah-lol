---
import Base from '../layouts/Base.astro';import {rooms} from '../data/rooms';
---
<Base><section class="lobby-heading"><p class="eyebrow">I am Jah Noah</p><h1>Unified<br/><em>Infinity.</em></h1><p class="role">Artist | Technologist | Yogi</p></section><section class="room-cards" aria-label="Three rooms">{rooms.map(r=><a class={`room-card ${r.theme}`} href={`/${r.id}`}><img src={`/images/${r.image}.webp`} alt={r.alt} width="1280" height="960"/><div><h2>{r.name}</h2><p>{r.keywords.join(' · ')}</p><span class="entry-label">Enter room</span></div></a>)}</section><section class="lobby-note"><blockquote><p>“We all have profound wisdom to share, so the more people catch on that they may share their light bright and long, the better.”</p><cite>Jah Noah · <a href="/Journal/share-their-light">Source excerpt</a></cite></blockquote><a href="/Journal">Journal · all rooms</a></section></Base>
