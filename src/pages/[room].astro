---
import Base from '../layouts/Base.astro';import {Companion} from '../components/animations';import {rooms} from '../data/rooms';import Media,{type MediaItem} from '../components/Media';import ForestSound from '../components/ForestSound';import RoomJournal from '../components/RoomJournal.astro';import quotes from '../content/quotes.json';
export function getStaticPaths(){return rooms.map(room=>({params:{room:room.id},props:{room}}))};const {room}=Astro.props;
const items:MediaItem[]=room.id==='Bloom'?[{title:'Left Behind · KuuJah',id:'2253698492',kind:'soundcloud',url:'https://soundcloud.com/kj9e4/left-behind'}]:room.id==='Orbit'?[{title:'Soapy Butterfly · KuuJah',id:'1558956466',kind:'soundcloud',url:'https://soundcloud.com/kj9e4/soapy-butterfly'},{title:'Adam’s Ribs · KuuJah',id:'2248943831',kind:'soundcloud',url:'https://soundcloud.com/kj9e4/adams-ribs'},{title:'Arduino MIDI Control with Joystick',id:'NzQkE8XGuPY',kind:'youtube',url:'https://www.youtube.com/watch?v=NzQkE8XGuPY'}]:[{title:'all is one · Jah Noah',id:'fws-pzWslnw',kind:'youtube',url:'https://www.youtube.com/watch?v=fws-pzWslnw'}];
const words=room.id==='Canopy'?quotes.find(q=>q.id==='jah-42'):room.id==='Orbit'?quotes.find(q=>q.id==='jah-01'):null;
const lyricFiles=import.meta.glob('../content/lyrics/*.txt',{query:'?raw',import:'default',eager:true});const lyrics=lyricFiles['../content/lyrics/left-behind.txt'] as string|undefined;
---
<Base title={`${room.name} — Jah Noah`} theme={room.theme}><section class="room-top"><div><p class="eyebrow">Jah Noah · {room.id==='Bloom'?'KuuJah':room.id==='Orbit'?'Solarpunk / Hyperspace':'A world recovering'}</p><h1>{room.name}<em>.</em></h1><ul class="keywords">{room.keywords.map(k=><li>{k}</li>)}</ul><p class="room-track">{room.id==='Canopy'?'Frogs · Crickets · Florida':room.title}</p>{room.note&&<p class="owner-note">“{room.note}” <span>— KuuJah · Left Behind lyrics</span></p>}</div><figure class="room-scene"><div class="scene-rim" aria-hidden="true"></div><img src={`/images/${room.image}.webp`} alt={room.alt} width="1280" height="960" fetchpriority="high"/><figcaption><a href={`/credits#${room.image}`}>NASA / Commons · Photograph credits</a></figcaption></figure></section><Companion client:visible kind={room.id==='Bloom'?'butterfly':room.id==='Canopy'?'frog':'saucer'} label={room.id==='Bloom'?'Butterfly':room.id==='Canopy'?'Frog':'Flying saucer'}/><section class="room-listening"><div><h2>{room.id==='Canopy'?'Watch':'Listen & watch'}</h2><Media client:visible items={items}/>{room.id==='Bloom'&&lyrics?.trim()&&<section class="lyrics"><h2>Lyrics · Left Behind</h2><pre>{lyrics}</pre><p>KuuJah</p></section>}</div>{room.id==='Canopy'?<ForestSound client:visible/>:<aside class="room-side"><p class="eyebrow">{room.id==='Bloom'?'Music / Art':'Technology / Music'}</p>{room.id==='Orbit'?<a href="https://jahnoah.com/Tech">Jah Noah · Development <small>External ↗</small></a>:<a href="https://soundcloud.com/kj9e4">KuuJah · SoundCloud <small>External ↗</small></a>}<a href="/Journal">Poetry · Photos · Notes</a></aside>}</section>{words&&<section class="room-words"><blockquote><p>“{words.text}”</p><cite>Jah Noah · {words.date} · <a href="https://github.com/onlyjah/onlyjah-com/blob/dev/reconcile-cloud-rebuild/src/content/quotes.json">Source · External ↗</a></cite></blockquote></section>}<RoomJournal room={room.id}/></Base>
