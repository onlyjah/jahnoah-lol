---
import '../styles/global.css';import RoomControls from '../components/RoomControls';
const {title='Jah Noah · Unified Infinity',theme='lobby'}=Astro.props;
---
<!doctype html><html lang="en" data-motion="off"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="robots" content="noindex, nofollow"/><meta name="description" content="Jah Noah. Music, art, words and experiments."/><link rel="canonical" href={new URL(Astro.url.pathname,'https://jahnoah.lol')}/></head><body data-theme={theme}><a class="skip" href="#main">Skip to content</a><header><a class="wordmark" href="/">Jah Noah<span>.lol</span></a><nav aria-label="Main navigation">{['Bloom','Orbit','Canopy'].map(room=><a href={`/${room}`} aria-current={Astro.url.pathname.split('/')[1]===room?'page':undefined}>{room}</a>)}<a href="/Journal">Journal</a></nav><RoomControls client:load/></header><main id="main"><slot/></main><footer><a href="https://onlyjah.com">OnlyJah <small>External ↗</small></a><a href="https://jahnoah.com">Hire Jah Noah · JahNoah.com <small>External ↗</small></a><a href="/credits">Media credits</a><a href="mailto:mail@jahnoah.com">Email Jah Noah</a><span>© {new Date().getFullYear()} Jah Noah</span></footer></body></html>
